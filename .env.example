# Copie para .env e preencha. O .env nao vai para o repositorio.

# SQL Server (senha forte obrigatoria: maiuscula, minuscula, numero e simbolo)
SQL_PASSWORD=TroqueEstaSenha@2026

# Chave de assinatura do JWT. Minimo 32 caracteres.
# Gere com: openssl rand -base64 48
JWT_SECRET=

# Anthropic
ANTHROPIC_API_KEY=

# Evolution API — roda como container "evolution" neste mesmo docker-compose.
# Por isso o endereço é o nome do serviço, nunca "localhost" (que dentro de um
# container se refere a ele mesmo, não à sua máquina nem a outro container).
EVOLUTION_BASE_URL=http://evolution:8080
# Chave que o SEU sistema usa para se autenticar na Evolution que você mesmo hospeda.
# Pode ser qualquer string longa e aleatória — gere com: openssl rand -hex 24
EVOLUTION_API_KEY=
# Senha do Postgres interno da Evolution (guarda sessão/instância do WhatsApp).
EVOLUTION_DB_PASSWORD=TroqueEstaSenhaTambem@2026
# Só muda se você for expor a Evolution num domínio público de verdade.
EVOLUTION_PUBLIC_URL=http://localhost:8080

# URLs
API_URL=http://localhost:5080
FRONTEND_URL=http://localhost:4200
ASPNETCORE_ENVIRONMENT=Development
